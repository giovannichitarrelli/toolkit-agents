# Copie para provas/.env — NUNCA commite o .env.
# provas/.env precisa estar no .gitignore do subprojeto.

SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_ANON_KEY=

# JWT de usuário real, um por papel que as provas exercitam.
# Gere com o login normal do app; nunca use service_role aqui.
PROVA_JWT_ORGANIZADOR=
PROVA_JWT_CLIENTE=
PROVA_JWT_OUTRO_ORGANIZADOR=

# Só para montar cenário e limpar. Nunca para provar.
SUPABASE_SERVICE_ROLE_KEY=
